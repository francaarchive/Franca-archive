---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';

const entradas = (await getCollection('arquivo', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.valueOf() - a.data.valueOf());

const fmtCat = (n) => 'FA·' + String(n).padStart(3, '0');
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow meta reveal" style="animation-delay:.05s">Arquivo de história das artes e do design</div>
      <h1 class="reveal" style="animation-delay:.15s">tudo começa<br>com a história</h1>
      <p class="lede reveal" style="animation-delay:.3s">
        Tudo começa com a obra, e com alguém disposto a contá-la.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <h2>O Arquivo</h2>
        <div class="rule"></div>
        <div class="meta">{entradas.length} {entradas.length === 1 ? 'entrada' : 'entradas'}</div>
      </div>
      <div class="ledger">
        {entradas.map((e, i) => (
          <Entry
            href={`/arquivo/${e.slug}`}
            cat={fmtCat(entradas.length - i)}
            eixo={e.data.eixo}
            periodo={e.data.periodo}
            titulo={e.data.titulo}
            subtitulo={e.data.subtitulo}
          />
        ))}
      </div>
    </div>
  </section>
</Base>